[configuration]

entry_symbol = "triroute_library_init"
compatibility_minimum = "4.4"
reloadable = true

[libraries]

linux.debug.x86_64 = "res://bin/libtriroute.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libtriroute.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://bin/libtriroute.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libtriroute.windows.template_release.x86_64.dll"
